# Copie para api/.env e preencha. Não commitar api/.env.

DOWNLOADS_DIR=/data/downloads
CORTES_DIR=/data/cortes
HOST=0.0.0.0
PORT=8000

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=videocortes

# MinIO S3
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
MINIO_REGION=us-east-1
MINIO_BUCKET=videocortes

# Usuário padrão (importações locais / fallback de disco)
DEFAULT_USUARIO_ID=

# JWT
JWT_SECRET=
JWT_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=vc_token

# Origens do front (API CORS + player MinIO)
CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101,https://video-cortes-app.r2lqib.easypanel.host
MINIO_CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101,https://video-cortes-app.r2lqib.easypanel.host
PLAYBACK_URL_EXPIRE_SECONDS=7200
